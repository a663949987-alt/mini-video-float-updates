<Window x:Class="MiniVideoFloat.SelectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="选剧 / 选集" Width="420" Height="485" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft YaHei" FontSize="12">
 <Window.Resources>
  <Style x:Key="SmallButton" TargetType="Button"><Setter Property="Background" Value="#FFF0E7"/><Setter Property="Foreground" Value="#E66314"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="EpisodeButton" TargetType="Button" BasedOn="{StaticResource SmallButton}"><Setter Property="Background" Value="#F5F3F1"/><Setter Property="Foreground" Value="#514B47"/><Setter Property="Margin" Value="4,3"/><Setter Property="Padding" Value="3"/></Style>
 </Window.Resources>
 <Border Background="#FFF8F4" CornerRadius="12" BorderBrush="#E9DDD4" BorderThickness="1">
  <Grid Margin="17,12,17,10">
   <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="30"/><RowDefinition Height="42"/><RowDefinition Height="30"/><RowDefinition Height="114"/><RowDefinition Height="29"/><RowDefinition Height="*"/><RowDefinition Height="26"/><RowDefinition Height="20"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" MouseLeftButtonDown="Header_Drag"><StackPanel Orientation="Horizontal"><Border Width="21" Height="21" CornerRadius="6" Background="#FF7018"><TextBlock Text="▶" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="选剧 / 选集" FontSize="15" FontWeight="Bold" Foreground="#242424" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><Button Content="×" Click="Close_Click" HorizontalAlignment="Right" Width="25" FontSize="18" Foreground="#8F8985" Background="Transparent" BorderThickness="0" Cursor="Hand"/></Grid>
   <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="暂停 / 继续" Style="{StaticResource SmallButton}" Click="Pause_Click" Margin="0,0,6,0"/><Button Content="下一集" Style="{StaticResource SmallButton}" Click="Next_Click" Margin="0,0,6,0"/><Button Content="静音 / 声音" Style="{StaticResource SmallButton}" Click="Mute_Click" Margin="0,0,6,0"/><Button Content="更多设置" Style="{StaticResource SmallButton}" Click="Settings_Click"/></StackPanel>
   <Grid Grid.Row="2" Margin="0,3"><Border Background="White" CornerRadius="8" BorderBrush="#E8E2DE" BorderThickness="1"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Margin="10,0,69,0" VerticalContentAlignment="Center" MaxLength="80" KeyDown="SearchBox_KeyDown" ToolTip="输入短剧名称"/><TextBlock Text="搜索短剧名称" Foreground="#A7A09B" Margin="12,0,70,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="搜索" Width="58" Height="29" HorizontalAlignment="Right" Margin="0,0,4,0" Background="#FF7018" Foreground="White" Style="{StaticResource SmallButton}" Click="Search_Click"/></Grid>
   <Grid Grid.Row="3"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HistoryTab" Content="观看历史" Click="History_Click" BorderThickness="0" Padding="0,0,10,0" Background="Transparent" Foreground="#E66314" FontWeight="Bold" Cursor="Hand"/><Button x:Name="ResultsTab" Content="搜索结果" Click="Results_Click" BorderThickness="0" Padding="0,0,10,0" Background="Transparent" Foreground="#8D8885" Cursor="Hand"/><Button x:Name="HotTab" Content="热门榜" Click="Hot_Click" BorderThickness="0" Padding="0" Background="Transparent" Foreground="#8D8885" Cursor="Hand"/></StackPanel><Button x:Name="MoreButton" Content="加载更多 ›" HorizontalAlignment="Right" Click="More_Click" BorderThickness="0" Background="Transparent" Foreground="#9A918B" Cursor="Hand" Visibility="Collapsed"/></Grid>
   <ListBox x:Name="SeriesList" Grid.Row="4" BorderThickness="0" Background="Transparent" SelectionChanged="SeriesList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="White" CornerRadius="7" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F3B589"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,4" Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Border Width="27" Height="36" CornerRadius="4" Background="#E5BBA8"><TextBlock Text="剧" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="#262626" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="#9C938D" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding}" Style="{StaticResource SmallButton}" Click="SeriesAction_Click" FontSize="10" Padding="4,3"/></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Grid Grid.Row="5"><TextBlock Text="选集" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="SelectedTitle" Foreground="#9C938D" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="285"/></Grid>
   <Border Grid.Row="6" Background="White" CornerRadius="8"><UniformGrid x:Name="EpisodeGrid" Rows="3" Columns="6" Margin="6"/></Border>
   <Grid Grid.Row="7"><Button Content="‹ 上一页" HorizontalAlignment="Left" Click="Previous_Click" BorderThickness="0" Background="Transparent" Foreground="#9C938D"/><TextBlock x:Name="PageText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9C938D"/><Button Content="下一页 ›" HorizontalAlignment="Right" Click="NextPage_Click" BorderThickness="0" Background="Transparent" Foreground="#9C938D"/></Grid>
   <TextBlock x:Name="StatusText" Grid.Row="8" FontSize="10" Foreground="#9C6F54" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
  </Grid>
 </Border>
</Window>
